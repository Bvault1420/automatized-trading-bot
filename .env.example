# ---------------------------------------------------------------------------
# Aletheia Trading Bot – Konfiguration
# Kopiere diese Datei nach ".env" und passe sie an.
# Ohne jede Anpassung laeuft der Bot im PAPER-Modus (Simulation mit echten
# Live-Kursen). Es wird kein echtes Geld bewegt.
# ---------------------------------------------------------------------------

# Server
PORT=8787
# Nur dieser Rechner (empfohlen). 0.0.0.0 macht die API im Netz erreichbar.
BIND_HOST=127.0.0.1
# Erlaubte Origins fuer das Dashboard (Komma-getrennt)
CORS_ORIGIN=http://localhost:5173

# --- Handelsmodus -----------------------------------------------------------
# paper = Simulation mit echten Live-Preisen (Standard, kein Risiko)
# live  = echte On-Chain-Swaps mit dem Bot-Wallet (echtes Geld!)
TRADING_MODE=paper

# Startkapital fuer den Paper-Modus in USD
PAPER_START_BALANCE=11

# --- Chain / Live-Trading ---------------------------------------------------
# Chain fuer den Live-Handel. Standard: solana (dort ist das Memecoin-Volumen).
# Alternativen: base, ethereum, bsc, arbitrum (EVM, KyberSwap/LiFi)
CHAIN=solana
# Eigener RPC-Endpunkt. Leer = oeffentlicher Solana-RPC (bei Limits: Helius/Triton)
RPC_URL=
# Passphrase zur Verschluesselung des Bot-Wallet-Keystores (Pflicht fuer live)
WALLET_PASSPHRASE=
# Optional: 0x Swap API Key als zusaetzlicher Router (https://dashboard.0x.org)
# Echte Swaps funktionieren auch ohne Key (KyberSwap + LiFi).
ZEROX_API_KEY=

# --- Risiko-Parameter (koennen auch im Dashboard geaendert werden) ----------
MAX_OPEN_POSITIONS=2
RISK_PER_TRADE_PCT=14
STOP_LOSS_PCT=11
TAKE_PROFIT_PCT=20
TRAILING_STOP_PCT=8
MAX_HOLD_MINUTES=25
DAILY_LOSS_LIMIT_PCT=18
MAX_DRAWDOWN_PCT=32
MIN_LIQUIDITY_USD=40000
MAX_SLIPPAGE_PCT=5
MIN_ENTRY_SCORE=64

# --- Optionale Datenquellen (verbessern die Signalqualitaet) ----------------
# https://cryptopanic.com/developers/api/  (ohne Key werden RSS-Feeds genutzt)
CRYPTOPANIC_API_KEY=
