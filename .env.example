# ---------- Supabase (Pflicht) ----------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (neu, sb_publishable_…) ODER der klassische "anon" Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Alternativ:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service-Role-Key (NUR serverseitig!) – für Kontolöschung und Seed-Skript
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- App ----------
NEXT_PUBLIC_APP_NAME=Playfeed
# Öffentliche URL der App (für Links in E-Mails, OG-Tags, Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth-Anbieter anzeigen (müssen in Supabase → Authentication → Providers konfiguriert sein)
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_AUTH_GITHUB=false

# ---------- Impressum / Datenschutz (Pflichtangaben in DE) ----------
NEXT_PUBLIC_LEGAL_NAME="Max Mustermann"
NEXT_PUBLIC_LEGAL_ADDRESS="Musterstraße 1, 12345 Musterstadt, Deutschland"
NEXT_PUBLIC_LEGAL_EMAIL=kontakt@example.com
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
NEXT_PUBLIC_LEGAL_VAT_ID=
NEXT_PUBLIC_LEGAL_REGISTER=
NEXT_PUBLIC_LEGAL_DPO_EMAIL=
NEXT_PUBLIC_HOSTING_PROVIDER="Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, USA"

# ---------- KI-Spielgenerator (optional) ----------
# OpenAI-kompatible Chat-Completions-API (OpenAI, OpenRouter, Groq, Together, …)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=20

# ---------- Seed-Skript (optional) ----------
SEED_EMAIL=official@playfeed.local
SEED_USERNAME=playfeed
# ADMIN_EMAIL=du@example.com
