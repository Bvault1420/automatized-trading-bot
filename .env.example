# Aegis Trading Bot
# Paper-Trading startet automatisch mit 100 EUR. Live bleibt aus, bis Schlüssel + Bestätigung da sind.

BIND_HOST=0.0.0.0
PORT=8787
DATA_DIR=./data

# Pflicht für E-Mail-Alerts (Trades, Halt, Regeländerungen)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=aegis@localhost

# Optional: jeder geschlossene Trade per Mail (sonst nur wichtige Ereignisse + Tagesbericht)
EMAIL_EVERY_TRADE=true

# Live-Krypto (Binance Spot). Ohne Schlüssel bleibt nur Paper aktiv.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_DATA_URL=https://data-api.binance.vision

# Optional: Bybit öffentliche Preise (Paper-Venue-Vergleich)
BYBIT_BASE_URL=https://api.bybit.com

# Optional: Aktien-Live über Alpaca (Paper-URL ist der sichere Default)
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: zusätzliche Browser-Origins (kommagetrennt), falls du einen eigenen Tunnel nutzt
CORS_ORIGINS=

# Optional: extra Passwort für Live-Schaltfläche
LIVE_UNLOCK=
